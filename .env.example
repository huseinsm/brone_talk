# DOKUMENTASI variabel konfigurasi. Jangan disalin utuh ke systemd:
# EnvironmentFile menimpa Environment= di unit, dan nilai di sini bisa keliru untuk NUC.
# Isi rahasia saja di ~/.config/brone-talk/brone.env (chmod 600), dibuat oleh deploy/install.sh.
# Daftar lengkap, default, dan artinya: docs/configuration.md

# --- rahasia (WAJIB di brone.env, bukan di repo) ---
BRONE_DEEPSEEK_API_KEY=
BRONE_MAI_API_KEY=

# --- contoh override non-rahasia (untuk uji di laptop, BUKAN untuk unit NUC) ---
# BRONE_MODE=faq
# BRONE_STT_BACKEND=whisper
# BRONE_AUDIO_INPUT_BACKEND=sounddevice
# BRONE_PLAYBACK=0
