# Salin ke ~/.config/brone-talk/brone.env (di luar repo) lalu isi.
# Nilai di sini = default produksi (lihat docs/baseline-config.md).

BRONE_ENGINE=v4
BRONE_MODE=auto
BRONE_STT_BACKEND=mai
BRONE_WHISPER_MODEL=models/faster-whisper-small
BRONE_WHISPER_BEAM=5
BRONE_MAX_UTTERANCE_SECONDS=8
BRONE_HISTORY_MESSAGES=4
BRONE_LOCK=1
BRONE_LOCK_TIMEOUT_SECONDS=15
BRONE_OUTPUT_DEVICE=default
BRONE_PLAYBACK=1
BRONE_MQTT_BROKER=192.168.100.2
BRONE_MQTT_PORT=1883

# Rahasia (jangan commit)
BRONE_DEEPSEEK_API_KEY=
BRONE_MAI_API_KEY=
